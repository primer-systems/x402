{
  "name": "@primersystems/x402",
  "version": "1.1.0",
  "description": "Primer ecosystem toolkit for x402",
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "bin": {
    "x402": "./dist/cli.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsup src/index.ts src/cli.ts --format cjs,esm --dts",
    "dev": "tsup src/index.ts src/cli.ts --format cjs,esm --dts --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "commander": "^12.1.0",
    "viem": "^2.39.0"
  },
  "peerDependencies": {
    "@x402/core": "^2.0.0"
  },
  "peerDependenciesMeta": {
    "@x402/core": {
      "optional": false
    }
  },
  "devDependencies": {
    "@types/node": "^22.15.29",
    "@vitest/coverage-v8": "^4.1.9",
    "@x402/core": "^2.0.0",
    "tsup": "^8.4.0",
    "typescript": "^5.7.3",
    "vitest": "^4.1.9"
  },
  "keywords": [
    "x402",
    "primer",
    "payments",
    "micropayments",
    "chutes",
    "ai",
    "cli"
  ],
  "license": "Apache-2.0",
  "author": "Primer Systems",
  "repository": {
    "type": "git",
    "url": "https://github.com/primersystems/x402"
  },
  "files": [
    "dist"
  ]
}
