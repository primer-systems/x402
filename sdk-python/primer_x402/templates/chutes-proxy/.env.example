# Chutes API key - get one at https://chutes.ai
CHUTES_API_KEY=cpk_your_key_here

# Your wallet address to receive USDC payments
WALLET_ADDRESS=0xYourWalletAddress

# Price per 1000 tokens in USD (default: $0.001)
PRICE_PER_1K_TOKENS=0.001

# x402 Facilitator URL (default: Primer's facilitator)
FACILITATOR_URL=https://x402.primer.systems
